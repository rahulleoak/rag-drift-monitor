# --- Data: everything under data/ is ignored except the committed sample ---
data/*
!data/sample/
!data/sample/**
!data/raw/
data/raw/*
!data/raw/.gitkeep

# --- Caches and run outputs (embeddings, LLM responses, reports) ---
cache/
runs/
indexes/            # FAISS indexes saved by Agent C (D22)
*.npy
*.faiss

# --- Secrets ---
.env
.env.*
!.env.example

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# --- Editors / OS ---
.vscode/
.idea/
.DS_Store
